    "rules": [
      { "name": "The One Voice Rule", "body": "Оранжевый означает «действуй» или «сейчас». Он не служит декором, не красит заголовки и не обозначает оценку.", "section": "colors" },
      { "name": "The Traffic Light Is For Pitch Rule", "body": "Зелёный, жёлтый и красный зарезервированы под точность голоса и правильность ответа. Не использовать их для категорий, фаз или предупреждений.", "section": "colors" },
      { "name": "The Monochrome Evidence Rule", "body": "Бейджи доказательности — одна монохромная шкала насыщенности: залитый → контур текстом → контур линией → пунктир. Без цвета.", "section": "colors" },
      { "name": "The Steady Digits Rule", "body": "Любое меняющееся число набирается tabular-nums и получает min-width в ch.", "section": "typography" },
      { "name": "The Line Not Shadow Rule", "body": "Новая поверхность отделяется рамкой 1px line и сменой тона, не тенью.", "section": "elevation" }
